{
  "manifest_version": 3,
  "name": "Saksham Path - Web Accessibility",
  "version": "1.0.0",
  "description": "On-demand web accessibility assistant providing reading aids, Indian language translation, Hindi TTS, contrast, typography, and interactive controls.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Saksham Path - Web Accessibility",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "content/utils/i18n.js",
        "content/utils/storage.js",
        "content/utils/dom.js",
        "content/accessibility/font-size.js",
        "content/accessibility/line-spacing.js",
        "content/accessibility/letter-spacing.js",
        "content/accessibility/word-spacing.js",
        "content/accessibility/readable-font.js",
        "content/accessibility/grayscale.js",
        "content/accessibility/contrast.js",
        "content/accessibility/saturation.js",
        "content/accessibility/cursor.js",
        "content/accessibility/interactive-highlight.js",
        "content/accessibility/reading-guide.js",
        "content/accessibility/text-magnifier.js",
        "content/accessibility/text-to-speech.js",
        "content/accessibility/translator.js",
        "content/accessibility/manager.js",
        "content/widget.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/widget.css",
        "icons/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
